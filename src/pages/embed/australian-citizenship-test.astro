---
/** Embeddable tool (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import LicenceNotice from '../../components/LicenceNotice.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Australian citizenship practice test (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('test', 'en')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Tool tool={{ kind: 'quiz', props: { mode: 'exam' } }} lang="en" primary={true} seedKey="embed-australian-citizenship-test" />
    <p data-independant class="mt-2 text-center text-xs text-navy-600">Independent, non-government tool by <a href={`${SITE_URL}${route('test', 'en')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a>: tests and applications are handled only by Home Affairs.</p>
    <LicenceNotice class="mt-2 text-center text-[11px] text-navy-600" />
  </body>
</html>
