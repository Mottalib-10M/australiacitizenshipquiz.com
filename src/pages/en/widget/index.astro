---
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE_URL } from '../../../data/site-config';
import { route } from '../../../i18n/routes';
import { breadcrumbSchema } from '../../../lib/seo';
import { t } from '../../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/australian-citizenship-test/" title="Australian citizenship practice test" width="100%" height="820" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/australian-citizenship-date/" title="When can I apply for Australian citizenship" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free Australian citizenship mock test on your site" description="Add the free Australian citizenship mock test or the residence date calculator to a library, council or English class website with one iframe: no sign-up, no cookie, no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the mock test or the residence calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For libraries, councils, English classes and community groups that help future citizens.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Australian citizenship mock test</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Residence date calculator</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Conditions: keep the independent-site notice and the Creative Commons credit under the frame visible, and use the tools as they are, without warranty. When a fee or a rule changes, the embedded tool follows. Nothing your visitors answer reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/australian-citizenship-test/" title="Australian citizenship practice test" width="100%" height="820" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
